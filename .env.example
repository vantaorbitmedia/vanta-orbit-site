# Admin access
ADMIN_PASSWORD=your_admin_password_here
SESSION_SECRET=your_long_random_session_secret_here
ADMIN_2FA_SECRET=your_base32_totp_secret_here

# AI generation
OPENAI_API_KEY=your_openai_key_here
AI_MODEL_MAIN=gpt-5
AI_MODEL_PREMIUM=gpt-5.2
AI_MODEL_FAST=gpt-5-mini

# Optional backwards-compatible model list override
AI_MODELS=
AI_MODEL=

# Leonardo image generation
LEONARDO_API_KEY=your_leonardo_api_key_here
LEONARDO_MODEL_ID=
LEONARDO_IMAGE_WIDTH=1024
LEONARDO_IMAGE_HEIGHT=576
LEONARDO_NUM_IMAGES=1

# Supabase persistence
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
